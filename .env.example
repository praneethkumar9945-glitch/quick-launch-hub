# URL of the self-hosted PHP backend folder (see /php-backend/README.md).
# If php-backend/ is uploaded as public_html/api/, the endpoints live in the
# inner api/ folder, so the base URL is https://skillaiindia.com/api/api
# Leave empty to run the site without a backend (forms show an error instead of saving).
VITE_PHP_API_URL=https://skillaiindia.com/api/api
